library(ggplot2)

stock_df <- read.csv("C:/Users/IT/Downloads/stock_market_metrics.csv")

ggplot(stock_df, aes(x = Day, y = Close_Price)) +
  geom_line(color = "blue", linewidth = 1) +
  geom_point(size = 2) +
  labs(title = "Closing Price Trend", x = "Day", y = "Closing Price")

ggplot(stock_df, aes(x = Open_Price, y = Close_Price)) +
  geom_point(color = "red", size = 3) +
  geom_smooth(method = "lm", se = FALSE, color = "black") +
  labs(title = "Open vs Close Price", x = "Open Price", y = "Close Price")

ggplot(stock_df, aes(x = factor(Day), y = Volume)) +
  geom_bar(stat = "identity", fill = "darkgreen") +
  labs(title = "Trading Volume per Day", x = "Day", y = "Volume")




