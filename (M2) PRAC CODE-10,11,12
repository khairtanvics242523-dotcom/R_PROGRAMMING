library(ggplot2)

health_df <- read.csv("C:/Users/IT/Downloads/hospital_health_data.csv")

ggplot(health_df, aes(x = BMI)) +
  geom_histogram(binwidth = 2, fill = "steelblue", color = "black") +
  labs(title = "Distribution of BMI", x = "BMI", y = "Frequency")

ggplot(health_df, aes(x = Glucose_Level)) +
  geom_histogram(binwidth = 10, fill = "darkorange", color = "black") +
  labs(title = "Glucose Level Distribution", x = "Glucose Level", y = "Frequency")

ggplot(health_df, aes(x = "", y = Blood_Pressure)) +
  geom_boxplot(fill = "lightgreen") +
  labs(title = "Blood Pressure Box Plot", y = "Blood Pressure")

ggplot(health_df, aes(x = "", y = Cholesterol)) +
  geom_boxplot(fill = "plum") +
  labs(title = "Cholesterol Box Plot", y = "Cholesterol")





